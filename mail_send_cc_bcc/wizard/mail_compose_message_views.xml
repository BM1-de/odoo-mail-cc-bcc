<odoo>
    <record id="email_compose_message_wizard_form" model="ir.ui.view">
        <field name="name">mail.compose.message.form.mail_send_cc_bcc</field>
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form" />
        <field name="arch" type="xml">
            <!-- shown with the Cc line of Odoo -->
            <field name="subject_placeholder" position="before">
                <field
                    name="partner_bcc_ids"
                    string="Bcc"
                    widget="many2many_tags_email"
                    placeholder="Add Bcc recipients..."
                    groups="base.group_user"
                    invisible="composition_mode != 'comment' or subtype_is_log or (not partner_cc_allowed and not partner_bcc_ids)"
                    readonly="context.get('default_message_id')"
                    context="{'force_email': True, 'show_email': True, 'form_view_ref': 'base.view_partner_simple_form'}"
                />
            </field>
        </field>
    </record>
</odoo>
