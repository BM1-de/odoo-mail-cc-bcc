<odoo>
    <record id="view_mail_form" model="ir.ui.view">
        <field name="name">mail.mail.form.mail_send_cc_bcc</field>
        <field name="model">mail.mail</field>
        <field name="inherit_id" ref="mail.view_mail_form" />
        <field name="arch" type="xml">
            <field name="email_cc" position="after">
                <field
                    name="recipient_cc_ids"
                    widget="many2many_tags"
                    domain="[('active', '=', True)]"
                />
                <field
                    name="recipient_bcc_ids"
                    widget="many2many_tags"
                    domain="[('active', '=', True)]"
                />
                <field name="is_single_email" />
            </field>
        </field>
    </record>
</odoo>
